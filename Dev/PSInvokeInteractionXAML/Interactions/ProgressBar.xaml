<Border Name="WrapperForDEV" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="200" Background="White" Padding="8">
    <Border.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Border.Resources>
    <DockPanel>
        <ProgressBar Name="PBG_Progress" DockPanel.Dock="Bottom"/>
        <TextBlock Name="TBK_Message" TextWrapping="Wrap" TextAlignment="Left" VerticalAlignment="Center" HorizontalAlignment="Center" 
               Text="Message" FontSize="13" Margin="0,0,0,4"/>
    </DockPanel>
</Border>
